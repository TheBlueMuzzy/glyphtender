    "goals": "Goal order (first = tried first)",
    "nudge": "Two-birds nudge from the other goals (0–1)",
    "shifts": "Mood shifts",
    "chattiness": "Banter: how chatty (0–100)",
    "extras": "Glyphtender extras (nerve, vocabulary, multi-word bonus)",
    "extras.nerve": "Calls it when it thinks it's this far ahead (Magic)",
    "extras.vocabulary": "Vocabulary modifier (− = knows more words)",
    "extras.extraWordBonus": "SCORE: bonus per extra word in one cast"
  },
