    },
    "menuScreen": {
      "label": "Menu background",
      "help": "Behind a menu: the page colour and the body text. Click an empty spot around a menu.",
      "find": ".kit-screen",
      "style": ["bg", "on-bg", "muted", "focus", "font-body", "text-size", "density"]
    }
