      "style": ["primary", "muted", "surface", "ink", "border-width", "radius-control", "corner-shape", "depth-1", "glow", "motion-fast", "ease"],
      "sounds": ["ui.toggle.on", "ui.toggle.off"]
    },
    "menuSlider": {
      "label": "Slider",
      "help": "A slider (Settings → volume). Shared by every slider.",
      "find": ".kit-slider",
      "style": ["primary", "surface", "border", "border-width", "radius-control", "depth-1"]
    },
    "menuPicker": {
      "label": "◀ Picker ▶",
      "help": "A Selector or Stepper: ◀ value ▶ (New Game, Settings). Shared by every picker; its ◀ ▶ are Buttons.",
      "find": ".kit-picker",
      "style": ["surface", "on-surface", "border", "border-width", "radius-control", "corner-shape", "font-body"],
      "sounds": ["ui.tap"]
    },
    "menuTab": {
      "label": "Tab",
      "help": "One tab in a tab row (Settings). Shared by every tab.",
      "find": ".kit-tab",
      "style": ["primary", "on-primary", "surface", "on-surface", "muted", "border", "border-width", "radius-control", "corner-shape", "text-case"],
      "sounds": ["ui.tap"]
    },
    "menuRow": {
      "label": "List row",
      "help": "A row in a list (Settings, Credits). Shared by every row.",
      "find": ".kit-listrow",
      "style": ["on-surface", "muted", "border", "border-width"],
      "sounds": ["ui.tap"]
    },
    "menuBadge": {
      "label": "Badge",
      "help": "A small label chip. Shared by every badge.",
      "find": ".kit-badge",
      "style": ["primary", "on-primary", "surface", "on-surface", "danger", "on-danger", "border", "ink", "border-width", "radius-control", "corner-shape", "text-case"]
    },
    "menuTitle": {
      "label": "Menu title",
