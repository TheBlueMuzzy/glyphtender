{
  "_help": "Dev Kit Select tab: what you can click in the game, and the knobs each thing shows. knobs = tuning settings by section (\"<file>.<key>\"; a group brings all of it) · text = content/text/en.json keys (a branch brings all of it) · sounds = content/audio.json names · style = UI kit style values (content/ui/style.json, the Color tab) — shared by every part of that kind. Every tuning setting is on the thing it affects (rules too) — src/devkit-game/select.test.ts fails if one is missing; a thing's parts (a glyphling's danger ring) carry its tag. The game marks each thing with data-knobs=\"<id>\"; find = a CSS selector for kit parts the game can't mark.",
  "objects": {
    "glyphling": {
      "label": "Glyphling",
      "help": "A player's piece — on the board, or waiting in the tray during the draft — with its danger ring and tangle vine. Its settings change all of them.",
      "knobs": {
        "Look": ["garden.pieceScale", "garden.yellow", "garden.blue", "garden.purple", "garden.pink", "garden.ghostOpacity"],
        "Drag": ["drag.styles.move", "drag.styles.draft", "drag.liftScale", "drag.liftShadow", "drag.liftTime", "drag.landTime", "drag.flyTime", "layout.dragLift", "drag.targets.move", "drag.targets.draft", "drag.ghostOpacity", "drag.ghostGlow", "drag.fadeTime", "drag.snap", "drag.snapRadius", "drag.tetherBend", "drag.arrowSize", "layout.dragStartDistance"],
        "Move": ["anim.moveBase", "anim.movePerHex", "anim.moveSettle"],
        "Turn pulse & \"no\" shake": ["anim.turnPulseTime", "feel.events.turnPulse", "anim.noShakeTime", "feel.events.noShake"],
        "Danger ring": ["garden.warningWidth", "garden.warningDash"],
        "Tangle vine": ["garden.vine", "garden.vineWidth", "garden.tangledDim", "anim.tangleBlinkTime"],
        "Rules": ["rules.tanglesToEnd", "rules.tangleBonus"]
      },
      "text": ["tutorial.explore.yourGlyphling", "tutorial.explore.yourGlyphlingDanger", "tutorial.explore.yourGlyphlingTangled", "tutorial.explore.theirGlyphling", "tutorial.explore.theirGlyphlingDanger", "tutorial.explore.theirGlyphlingTangled", "tutorial.tips.yourDanger", "tutorial.tips.theirDanger", "tutorial.tips.tangleYours", "tutorial.tips.tangleTheirs"],
      "sounds": ["draft.place", "glyph.lift", "glyph.step", "no", "danger.warn", "tangle"]
    },
    "seed": {
      "label": "Seed",
      "help": "A letter seed — in the tray, flying, or planted on the board.",
      "knobs": {
        "Look": ["anim.seedSize", "garden.seedShine"],
        "Tray": ["layout.trayTileMin", "layout.trayGap"],
        "Drag": ["drag.styles.seed", "drag.targets.seed", "drag.ghostOpacity", "drag.ghostGlow", "drag.fadeTime", "drag.snap", "drag.snapRadius", "drag.tetherBend", "drag.arrowSize", "layout.dragStartDistance"],
        "Throw": ["anim.flightBase", "anim.flightPerHex", "anim.arcHeight", "anim.hopHeight", "anim.hopTime"],
        "Grow": ["anim.growTime", "anim.growFrom"]
      },
      "text": ["tutorial.explore.traySeed", "tutorial.explore.traySeedRefresh", "tutorial.explore.yourSeed", "tutorial.explore.theirSeed"],
      "sounds": ["seed.pick", "seed.drop", "seed.aim", "cast.throw", "seed.land", "sprout.grow"]
    },
    "plannedSeed": {
      "label": "Planned seed",
      "help": "A seed you've aimed but not planted yet (the see-through one).",
      "knobs": {
        "Look": ["garden.plannedSeedLook", "garden.plannedSeedOpacity", "garden.plannedMist", "garden.plannedMistStrength"],
        "Moon": ["garden.plannedMoonLight", "garden.plannedMoonShadow", "garden.plannedMoonBrightness"],
        "Stencil": ["garden.plannedStencilLetter", "garden.plannedStencilTile", "garden.plannedStencilCut", "garden.plannedStencilSoftness"],
        "Pulse": ["anim.pulseTime"]
      },
      "text": ["tutorial.explore.plannedSeed"]
    },
    "board": {
      "label": "Board",
      "help": "The garden: the hexes, their highlights and the turn trails.",
      "knobs": {
        "Look": ["garden.background", "garden.hexFill", "garden.hexLine", "garden.hexLineWidth"],
        "Highlights": ["garden.glowStrength", "garden.castFill", "garden.castShade", "garden.dropStrength"],
        "Turn trails": ["garden.trailWidth", "garden.trailStrength", "anim.trailLead", "anim.trailHold"],
        "Space around it": ["layout.boardMargin", "layout.edgeMargin", "layout.edgeMarginShare", "layout.promptGap"]
      },
      "text": ["tutorial.explore.emptyHex", "tutorial.explore.moveOption", "tutorial.explore.plantOption", "tutorial.explore.draftOption"]
    },
    "word": {
      "label": "Word",
      "help": "A word's outline — grown, or the preview while you plan one.",
      "knobs": {
        "Look": ["garden.wordBorder", "garden.wordBorderWidth", "garden.grownGlowStrength"],
        "Timing": ["anim.wordGlowTime"],
        "Sound rules": ["feel.sounds"],
        "Rules": ["rules.minWordLength", "rules.ownershipBonus", "rules.twoLetterWordsAtStart", "rules.britishWordsAtStart", "rules.vulgarWordsAtStart"]
      },
      "sounds": ["word.chord", "cast.flourish"]
    },
    "spotlight": {
      "label": "Spotlight label",
      "help": "The word + points label that shows over a new word (\"QUA +4\").",
      "knobs": {
        "Look": ["garden.spotlightLabel", "garden.spotlightLabelSize", "garden.spotlightLabelMinPx"],
        "Timing": ["anim.spotlightHold", "anim.spotlightFade"]
      },
      "text": ["game.spotlightLabel"]
    },
    "scorePop": {
      "label": "Score pop",
      "help": "The +2 / +1 that pops off each seed and flies into the total.",
      "knobs": {
        "Look": ["garden.scorePop", "garden.scorePopSize", "garden.scorePopMinPx"],
        "Timing": ["anim.scorePopDelay", "anim.scoreWordTime", "anim.scorePopGap", "anim.scorePopTime", "anim.scorePopHold", "anim.scoreFlyTime"],
        "Feel": ["feel.events.seedPop", "feel.tiers"]
      },
      "text": ["game.scorePop"],
      "sounds": ["score.pop"]
    },
    "scoreTotal": {
      "label": "Score total",
      "help": "The running total over the glyphling's head that counts up as the pops land.",
      "knobs": {
        "Look": ["garden.scoreTotalSize", "garden.scorePop"],
        "Timing": ["anim.scoreTotalHold", "anim.scoreTotalFade", "anim.scoreTotalGrow", "anim.scoreTotalMaxGrow"],
        "Feel": ["feel.events.totalPop", "feel.tiers"]
      },
      "sounds": ["score.arrive"]
    },
    "tray": {
      "label": "Seed tray",
      "help": "Your hand of seeds along the bottom (or side).",
      "find": "svg.game-tray",
      "knobs": {
        "Size": ["layout.trayTileMin", "layout.trayGap", "layout.stackedAspect", "layout.bottomRoom"],
        "Reorder": ["drag.styles.reorder", "drag.targets.reorder", "drag.makeRoom", "drag.roomTime", "drag.trayLeave"],
        "Refresh": ["anim.refreshShrinkTime", "anim.refreshGrowTime", "anim.refreshStagger", "anim.refreshPause", "feel.events.refreshGrow"],
        "Rules": ["rules.handSize"]
      },
      "sounds": ["refresh.out", "refresh.in", "tray.shuffle"]
    },
    "turnBar": {
      "label": "Turn indicator",
      "help": "Whose turn it is (the avatar + name at the top).",
      "knobs": {
        "Turn pulse": ["anim.turnPulseTime", "feel.events.turnPulse"],
        "Side panel": ["layout.sidePanelShare", "layout.sideShortHeight", "layout.sideShortMaxShare"],
        "Rules": ["rules.randomTurnOrder"]
      },
      "text": ["game.turnOf", "tutorial.explore.bar", "tutorial.explore.barDetail"],
      "sounds": ["turn.yours"]
    },
    "tip": {
      "label": "Sprout's tip",
      "help": "A tutorial callout or tip bubble.",
      "find": ".kit-callout",
      "knobs": {
        "Timing": ["tutorial.tipSeconds", "tutorial.tipDelay", "tutorial.tipsPerTurn", "tutorial.maxPauses", "tutorial.railsCalloutDelay"],
        "Nudges": ["tutorial.idleGlow", "tutorial.idleText", "tutorial.idleRepeat", "tutorial.laterIdleText", "tutorial.onlineIdleText", "tutorial.wrongRepeat"],
        "Look": ["tutorial.calloutRoom", "tutorial.railsDim"],
        "Sprout": ["tutorial.selfTangleBy", "tutorial.sproutSlowdown"],
        "Explore": ["tutorial.exploreRemind", "tutorial.exploreDim"]
      },
      "text": ["tutorial.tips", "tutorial.nudges", "tutorial.rails"]
    },
    "ribbon": {
      "label": "Award ribbon",
      "help": "The place ribbon on the end screen.",
      "knobs": {
        "Look": ["endscreen.ribbon1", "endscreen.ribbon2", "endscreen.ribbon3", "endscreen.ribbon4", "endscreen.ribbonSize"]
      }
    },
    "award": {
      "label": "Award",
      "help": "One award in the end screen's highlights: who earned it and why.",
      "knobs": {
        "Which comes first": ["endscreen.awardOrder"],
        "When it is earned": ["endscreen.lockdownMinDrop", "endscreen.lockdownMaxAfter", "endscreen.pincerMinFrom", "endscreen.pincerMinShare", "endscreen.weedMaxMagic", "endscreen.weedMinBlocked", "endscreen.weedMinCut", "endscreen.walledMinMagic", "endscreen.walledMaxSize", "endscreen.hedgeMinOver", "endscreen.powerPlayMin", "endscreen.powerPlayMinLetters", "endscreen.longWordMinSmall", "endscreen.longWordMinLarge", "endscreen.hijackMinFrom", "endscreen.bridgeMinLength", "endscreen.superBridgeMinLength", "endscreen.closeCallMinAfter", "endscreen.tricksterMinBehind", "endscreen.calledItMinLead"],
        "Carousel": ["endscreen.carouselSeconds", "endscreen.carouselPauseSeconds"]
      },
      "text": ["game.gameOver.awards", "game.gameOver.highlights"],
      "sounds": ["end.award"]
    },
    "storyChart": {
      "label": "Story chart",
      "help": "The end screen's Story page: everyone's Magic over the game, with moment markers and the turn list.",
      "knobs": {
        "Chart": ["endscreen.maxMarkers", "endscreen.chartDrawSeconds", "endscreen.chartLineWidth", "endscreen.chartHeight"],
        "Bot band": ["endscreen.botBandWidth", "endscreen.botBandDarken", "endscreen.botBandOpacity"],
        "Turn list": ["endscreen.storyListFontScale", "endscreen.storyListMaxWordChars", "endscreen.storyListBackdrop", "endscreen.storyListMaxWidth", "endscreen.storyListMaxHeight", "endscreen.storyListSmallest"]
      },
      "text": ["game.gameOver.chart"]
    },
    "resultsPage": {
      "label": "Results page",
      "help": "A page of the end screen (results, story, scorecard) — how big it may grow.",
      "knobs": {
        "Size": ["endscreen.pageFill", "endscreen.maxZoom"]
      },
      "text": ["game.gameOver.tabs", "game.gameOver.card"]
    },
    "reveal": {
      "label": "End reveal",
      "help": "The end-of-game ceremony: tangles, bonuses, the count, the winner.",
      "knobs": {
        "Timing": ["anim.revealTangles", "anim.tangleBlinkTime", "anim.revealBonus", "anim.revealCount", "anim.revealWinner", "anim.revealPopTime"],
        "Music": ["anim.revealMusicCalm", "anim.revealMusicPeak", "anim.revealMusicSettle"],
        "Look": ["garden.revealPop", "garden.revealPopSize", "layout.revealBigZoom", "layout.revealMinZoom"]
      },
      "text": ["game.reveal"],
      "sounds": ["reveal.tangles", "reveal.count", "reveal.bonus", "reveal.winner"]
    },
    "menuButton": {
      "label": "Button",
      "help": "Any UI kit button — menus, Pause, the HUD. Shared: changing it changes every button (main buttons use Main buttons; the quieter ones use Cards).",
      "find": ".kit-button",
      "style": ["primary", "on-primary", "surface", "on-surface", "danger", "on-danger", "border", "ink", "radius-control", "corner-shape", "border-width", "depth-0", "glow", "press-scale", "press-shift", "motion-fast", "ease", "text-case", "font-body"],
      "sounds": ["ui.tap", "ui.back"]
    },
    "menuToggle": {
      "label": "Toggle switch",
      "help": "An on / off switch (Settings). Shared by every switch.",
